# ATMT Labs accounts — environment.
#
# Copy to .env.local (git-ignored), fill in, then:
#   npm run keygen      # fills the generated secrets below (never overwrites)
#   npm run db:migrate  # creates the tables in Neon
#   npm run env:push    # uploads every value here to your Vercel project
#
# Never commit .env.local.

# ── Domains ─────────────────────────────────────────────────────────────────
SITE_ORIGIN=https://labs.atmt.dev
AUTH_ORIGIN=https://auth.labs.atmt.dev
API_ORIGIN=https://api.labs.atmt.dev

# ── Database (Neon via the Vercel Marketplace, Singapore) ──────────────────
# Injected automatically by the Neon integration; `vercel env pull .env.local`
# copies it here for local migrations.
DATABASE_URL=

# ── Generated by `npm run keygen` ───────────────────────────────────────────
SESSION_SECRET=
ACCESS_TOKEN_SECRET=
# Ed25519 private key (PKCS#8 PEM, \n-escaped on one line) that signs short-lived account tokens.
# Its PUBLIC half goes into src/shared/brand.ts → LICENSING.publicKeys[kid].
LICENSE_SIGNING_KEY=
LICENSE_SIGNING_KID=

# ── Google (console.cloud.google.com → APIs & Services → Credentials) ──────
# OAuth client type: Web application
# Authorized redirect URI: https://auth.labs.atmt.dev/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Yahoo (developer.yahoo.com/apps) ────────────────────────────────────────
# Redirect URI: https://auth.labs.atmt.dev/login/yahoo/callback
# Permissions: OpenID Connect → Email, Profile
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
