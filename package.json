{
  "name": "devlabs",
  "version": "4.1.3",
  "private": true,
  "description": "DevLabs — a local-first multi-agent harness that turns the CLI coding agents you already run into an office of agents on your machine.",
  "main": "out/main/index.js",
  "author": "jepoy.dev (https://jepoy.dev)",
  "contributors": [
    "Chaitanya Giri (original author, https://github.com/chaitanyagiri/munder-difflin)"
  ],
  "homepage": "https://devlabs.atmt.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffreycayao/Dev-Labs.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run copy:main-assets",
    "copy:main-assets": "node tools/copy-main-assets.cjs",
    "preview": "electron-vite preview",
    "postinstall": "electron-rebuild -f && node tools/ensure-pty-perms.cjs && node tools/patch-node-pty-conpty.cjs && node tools/install-git-hooks.cjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:focused": "node --test test/*.test.cjs",
    "check:links": "node tools/check-release-links.cjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "version:bump": "node tools/bump-version.cjs",
    "version:patch": "node tools/app-version.cjs bump patch",
    "version:minor": "node tools/app-version.cjs bump minor",
    "version:major": "node tools/app-version.cjs bump major",
    "version:check": "node tools/app-version.cjs check",
    "hooks:install": "node tools/install-git-hooks.cjs",
    "release:patch": "node tools/bump-version.cjs patch && npm run release:check",
    "release:minor": "node tools/bump-version.cjs minor && npm run release:check",
    "release:major": "node tools/bump-version.cjs major && npm run release:check",
    "release": "node tools/bump-version.cjs auto && npm run release:check",
    "release:check": "node tools/release-preflight.cjs"
  },
  "allowScripts": {
    "better-sqlite3": false
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@openai/agents-realtime": "^0.11.8",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^11.10.0",
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.6",
    "lucide-react": "^0.563.0",
    "monaco-editor": "^0.52.2",
    "node-pty": "^1.0.0",
    "posthog-node": "^5.48.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.183.2",
    "troika-three-text": "^0.52.5",
    "tunnelmole": "^2.4.0",
    "yauzl": "^2.10.0",
    "yazl": "^2.5.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^3.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.183.1",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/rebuild": "$@electron/rebuild"
    }
  }
}
